{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "api": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container",
      "bindings": [
        {
          "type": "service",
          "service": "scanner",
          "format": "url",
          "env": "SCANNER_URL"
        }
      ]
    },
    "scanner": {
      "root": ".",
      "entrypoint": "Containerfile.vercel",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
