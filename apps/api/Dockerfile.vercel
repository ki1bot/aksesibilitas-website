FROM golang:1.26.2-bookworm AS builder

WORKDIR /src

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/aksescheck-api \
    ./apps/api/cmd/api

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder \
    /out/aksescheck-api \
    /usr/local/bin/aksescheck-api

ENV APP_ENV=production
ENV API_ADDR=:80

EXPOSE 80

CMD ["/usr/local/bin/aksescheck-api"]