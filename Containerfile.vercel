FROM golang:1.26.2-bookworm AS builder

WORKDIR /src

COPY go.mod go.sum ./

RUN go mod download

COPY apps/scanner ./apps/scanner
COPY internal ./internal
COPY embedded ./embedded

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/aksescheck-scanner \
    ./apps/scanner/cmd/scanner

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        chromium \
        fonts-liberation \
        fonts-noto-color-emoji \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN printf '%s\n' \
    '#!/bin/sh' \
    'exec /usr/bin/chromium --no-sandbox "$@"' \
    > /usr/local/bin/chromium-vercel \
    && chmod +x /usr/local/bin/chromium-vercel

COPY --from=builder \
    /out/aksescheck-scanner \
    /usr/local/bin/aksescheck-scanner

ENV APP_ENV=production
ENV SCANNER_ADDR=:80
ENV CHROME_PATH=/usr/local/bin/chromium-vercel

EXPOSE 80

CMD ["/usr/local/bin/aksescheck-scanner"]